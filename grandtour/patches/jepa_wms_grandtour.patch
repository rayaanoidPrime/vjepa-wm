+# Copyright (c) 2026, contributed for the GrandTour (ANYmal-D) project.
+# GrandTour episode dataset for JEPA-WMs (Option B / guide-faithful schema).
+#
+# File layout (mirrors franka_custom: <dset>/<name>/data/<task>/<run>/episode.h5):
+#   $JEPAWM_DSET/grand_tour/data/<mission>/episode.h5   (one h5 per mission)
+#       attrs: camera="hdr_front", n_frames, joint_ids
+#       cam_timestamp [N]        float64 seconds (camera ~10 fps)
+#       frames_bytes   [M]       uint8  concatenated resized JPEGs
+#       frames_offsets [N+1]     int64  byte offsets of each frame
+#       cmd_twist      [N,3]     [vx, vy, yaw_rate] commanded twist
+#       joints         [N,36]    12 joints x (position, velocity, torque)
+#       pose           [N,7]     base pose xyz + quat(xyzw) from dlio odometry
+#
+# __getitem__ returns a random contiguous window of `frames_per_clip` model frames
+# (stride computed from target fps vs true camera rate), mirroring the
+# DROIDVideoDataset item contract used by the real-robot training branch:
+#   (obs, actions, states, reward)  with obs = {"visual": TCHW float [0,1] pre-norm,
+#                                               "proprio": joints normalized [T,36]}
+#   actions = concat([cmd_twist, (joints-mean)/std])  [T, 39]  (guide: "3 or 3+36")
+#   states  = pose [T,7]
+import json
+import io
+from logging import getLogger
+from pathlib import Path
+
+import h5py
+import numpy as np
+import torch
+import torch.utils.data
+from PIL import Image
+
+logger = getLogger(__name__)
+
+
+def _nearest(ref_ts, query_ts):
+    i = np.searchsorted(ref_ts, query_ts)
+    i = np.clip(i, 0, len(ref_ts) - 1)
+    lo = np.maximum(i - 1, 0)
+    take = np.where(np.abs(ref_ts[lo] - query_ts) <= np.abs(ref_ts[i] - query_ts), lo, i)
+    return take
+
+
+class GrandTourEpisode:
+    """Lazy per-episode arrays; frame bytes read on demand."""
+
+    def __init__(self, path: str):
+        self.path = path
+        with h5py.File(path, "r") as h5:
+            self.n_frames = int(h5.attrs["n_frames"])
+            self.camera = str(h5.attrs.get("camera", "hdr_front"))
+            self.cam_ts = np.asarray(h5["cam_timestamp"][:], np.float64)
+            self.cmd = np.asarray(h5["cmd_twist"][:], np.float32)
+            self.joints = np.asarray(h5["joints"][:], np.float32)
+            self.pose = np.asarray(h5["pose"][:], np.float32)
+            off = np.asarray(h5["frames_offsets"][:], np.int64)
+            self._nbytes = int(h5["frames_bytes"].shape[0])
+        self.offsets = off
+        dts = np.diff(self.cam_ts)
+        dts = dts[dts > 0]
+        self.dt = float(np.median(dts)) if len(dts) else 0.1
+
+    def read_frame(self, h5, i: int) -> Image.Image:
+        s, e = int(self.offsets[i]), int(self.offsets[i + 1])
+        raw = h5["frames_bytes"][s:e].tobytes()
+        return Image.open(io.BytesIO(raw)).convert("RGB")
+
+
+class GrandTourVideoDataset(torch.utils.data.Dataset):
+    """Windowed clip sampler over GrandTour episodes (real-robot branch analog)."""
+
+    def __init__(
+        self,
+        data_path,
+        frames_per_clip=12,
+        fps=5,
+        transform=None,
+        mpk_manifest_patterns=None,
+        seed=None,
+        dset_fraction=1.0,
+        norm_rows=8192,
+        **kwargs,
+    ):
+        self.data_path = str(data_path)
+        self.frames_per_clip = int(frames_per_clip)
+        self.fps = float(fps)
+        self.transform = transform
+        self.seed = seed
+        self.rng = np.random.RandomState(seed)
+
+        patterns = list(mpk_manifest_patterns) if mpk_manifest_patterns else ["**/episode.h5"]
+        files = []
+        for pat in patterns:
+            files.extend(sorted(Path(self.data_path).glob(pat.lstrip("/"))))
+        if not files:
+            raise FileNotFoundError(f"No episode.h5 under {self.data_path} (patterns={patterns})")
+        self.samples = [str(p) for p in files]
+        if dset_fraction < 1.0:
+            n = max(1, int(len(self.samples) * dset_fraction))
+            self.samples = self.samples[:n]
+            logger.info(f"GrandTour: sliced to {n} episodes ({dset_fraction:.2f})")
+        logger.info(f"GrandTour: {len(self.samples)} episodes under {self.data_path}")
+
+        self.episodes = [GrandTourEpisode(p) for p in self.samples]
+        self.action_dim = 3 + 36            # concat(cmd_twist, joints)
+        self.proprio_dim = 36
+        self.state_dim = 7                  # base pose xyz + quat(xyzw)
+        self.seq_lengths = [e.n_frames for e in self.episodes]
+
+        # -- per-frame alignment check: action/state rows must match camera frames
+        for e in self.episodes:
+            assert len(e.cmd) == e.n_frames and len(e.joints) == e.n_frames and len(e.pose) == e.n_frames
+
+        # -- joint normalization statistics (sampled rows across episodes)
+        rs = np.random.RandomState(0)
+        rows = []
+        for e in self.episodes:
+            n = min(e.n_frames, max(1, norm_rows // max(1, len(self.episodes))))
+            idx = rs.randint(0, e.n_frames, size=n)
+            rows.append(e.joints[idx])
+        jr = np.concatenate(rows)
+        jm = jr.mean(0)
+        js = jr.std(0)
+        js[js < 1e-6] = 1.0
+        self.joint_mean = torch.as_tensor(jm, dtype=torch.float32)
+        self.joint_std = torch.as_tensor(js, dtype=torch.float32)
+
+        # identity stats for cmd / pose (kept raw)
+        z3 = torch.zeros(3); o3 = torch.ones(3)
+        self.action_mean = torch.cat([z3, self.joint_mean])
+        self.action_std = torch.cat([o3, self.joint_std])
+        self.proprio_mean = self.joint_mean
+        self.proprio_std = self.joint_std
+        self.state_mean = torch.zeros(self.state_dim)
+        self.state_std = torch.ones(self.state_dim)
+        self.actions = None
+        self.states = None
+        self.proprios = None
+        self.rewards = None
+
+    def get_seq_length(self, idx):
+        return self.episodes[idx].n_frames
+
+    def __len__(self):
+        return len(self.samples)
+
+    def _decode(self, ep, h5, idx):
+        T = len(idx)
+        ims = []
+        for i in idx:
+            ims.append(np.asarray(ep.read_frame(h5, i), np.uint8))
+        arr = np.stack(ims)  # T,H,W,3
+        buf = torch.as_tensor(arr, dtype=torch.float32) / 255.0
+        buf = buf.permute(0, 3, 1, 2).contiguous()  # T,C,H,W
+        if self.transform is not None:
+            buf = self.transform(buf)
+        return buf
+
+    def __getitem__(self, idx):
+        ep = self.episodes[idx]
+        fstp = max(1, int(round((1.0 / self.fps) / ep.dt))) if ep.dt > 0 else 1
+        need = self.frames_per_clip * fstp
+        if need > ep.n_frames:
+            raise RuntimeError(f"episode {ep.path} too short: {ep.n_frames} < {need}")
+        sf = self.rng.randint(0, ep.n_frames - need + 1)
+        fidx = sf + np.arange(self.frames_per_clip) * fstp
+        fidx = fidx.astype(np.int64)
+        with h5py.File(ep.path, "r") as h5:
+            buffer = self._decode(ep, h5, fidx)
+        joints = torch.as_tensor(ep.joints[fidx], dtype=torch.float32)
+        joints_n = (joints - self.joint_mean) / self.joint_std
+        cmd = torch.as_tensor(ep.cmd[fidx], dtype=torch.float32)
+        act = torch.cat([cmd, joints_n], dim=-1)     # T,39
+        pose = torch.as_tensor(ep.pose[fidx], dtype=torch.float32)
+        obs = {"visual": buffer, "proprio": joints_n}
+        return obs, act, pose, torch.tensor(0.0)
+
+    def __getstate__(self):
+        d = self.__dict__.copy()
+        d.pop("rng", None)
+        return d
+
+    def __setstate__(self, d):
+        self.__dict__.update(d)
+        self.rng = np.random.RandomState(self.seed)
